# Copy this file to .env and change the values. .env is gitignored — never commit it.

# PostgreSQL (docker-compose service "db")
DB_NAME=hrm
DB_USER=hrm
# Avoid ";" in the password: it ends up inside the API's connection string.
DB_PASSWORD=change-me
# Host port for the database (localhost only). Change it if 5432 is already used on your machine.
DB_PORT=5432

# API (docker-compose service "api")
# JWT signing key, at least 44 characters. Generate one with:
#   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_KEY=
# Password of every demo account created on first start (8+ chars, upper, lower, digit, symbol).
SEED_PASSWORD=

# Web (docker-compose service "web"): the app is served at http://localhost:${WEB_PORT}
WEB_PORT=8080
