# Files that end up inside Linux containers keep LF line endings, even in a Windows checkout
# with core.autocrlf=true (a CRLF in an Nginx config or a Dockerfile RUN line breaks the build).
Dockerfile      text eol=lf
.dockerignore   text eol=lf
*.conf          text eol=lf
*.sh            text eol=lf
docker-compose.yml text eol=lf
.env.example    text eol=lf
